# smart-analytics 生产环境配置模板
# 复制为 /opt/smart-analytics/.env 并填写真实值。
# setup.sh 在首次部署时会自动生成一份带随机密钥的 .env，无需手动创建。

# 【必填·关键】固定密钥。务必固定！若不设置，cli.py 会在每次重启时随机生成，
# 导致所有已登录用户的会话立即失效（cookie 校验失败）。
# 生成命令： python3 -c "import secrets; print(secrets.token_hex(32))"
SMART_ANALYTICS_SECRET_KEY=replace-with-a-fixed-64-char-hex-string

# 【推荐】首个管理员密码。设置后首次启动自动创建管理员（邮箱见下），
# 且页面「修改密码」被禁用（密码由环境变量固定，比页面改更安全）。
SMART_ANALYTICS_PASSWORD=change-me-strong-password

# 管理员邮箱（仅用于 bootstrap 创建管理员账户）
SMART_ANALYTICS_ADMIN_EMAIL=admin@localhost

# 监听端口 —— 与 HabitHero 的 9999 完全无关，这里用 8001
SMART_ANALYTICS_PORT=8001

# 数据库文件路径 —— 独立文件，绝不触碰 HabitHero 的数据库
SMART_ANALYTICS_DB_PATH=/opt/smart-analytics/data/smart_analytics.db

# 是否开放公开注册（默认 true；生产建议 false，管理员密码已由上方环境变量固定）
SMART_ANALYTICS_OPEN_REGISTER=false
